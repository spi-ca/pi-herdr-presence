%% Diagram source: docs/diagram/protocol-negotiation.mmd
flowchart TB
  classDef core stroke-width:3px
  classDef boundary stroke-dasharray: 4 3
  classDef cmux stroke-width:3px,stroke-dasharray: 2 2

  Init[PresenceClient.initialize] --> Probe[V2 request:<br/>system.capabilities]
  Probe --> Cmux1[cmux]
  Cmux1 -->|response or error| Parse{Strict envelope:<br/>protocol cmux-socket,<br/>version 2, methods array}
  Parse -->|invalid, error,<br/>or timeout| Empty[supported = empty Set]
  Parse -->|valid| Filter[Keep only methods in<br/>the known OPTIONAL_METHODS allowlist]
  Filter --> Supported[supported: Set of V2Method]
  Empty --> Supported

  Supported --> V2Call{Optional V2 call requested}
  V2Call -->|notification / flash| CapabilityGate{method supported<br/>and config flag on?}
  V2Call -->|feed / auto-title / resume| OfficialGate{Official hook active?<br/>marker present AND<br/>CMUX_PI_HOOKS_DISABLED != 1}
  OfficialGate -->|yes: hook owns surface| SkipV2Hook[Skip silently]
  OfficialGate -->|no| CapabilityGate
  CapabilityGate -->|yes| SendV2[Encode + send<br/>exact V2 request]
  CapabilityGate -->|no| SkipV2[Skip silently]

  V1Call[V1 command:<br/>status / progress / log] --> ConfigGate{client.ts: config flag<br/>for this V1 surface on?}
  ConfigGate -->|yes| SendV1[Encode + send V1 line]
  ConfigGate -->|no| SkipV1[Skip silently]

  V1HookCall[V1 command:<br/>pid / lifecycle / meta] --> HookGate{Official hook active?<br/>marker present AND<br/>CMUX_PI_HOOKS_DISABLED != 1}
  HookGate -->|yes, hook owns surface| SkipV1Hook[Skip: official hook active]
  HookGate -->|no| ConfigGateHook{runtime.ts: nativeLifecycle /<br/>metaBlock flag on?}
  ConfigGateHook -->|yes| SendV1
  ConfigGateHook -->|no| SkipV1

  SendV2 --> Cmux2[cmux]
  SendV1 --> Cmux2
  Cmux2 -->|malformed, non-OK,<br/>or error| Fail[Best-effort failure<br/>swallowed, never thrown to Pi]
  Cmux2 -->|ok| Applied[Response accepted]

  class Supported,SendV1,SendV2,Applied core
  class Init,Probe,Parse,Filter,V2Call,OfficialGate,CapabilityGate,ConfigGate,Empty,SkipV1,SkipV2,SkipV2Hook,Fail,V1Call,V1HookCall,HookGate,ConfigGateHook,SkipV1Hook boundary
  class Cmux1,Cmux2 cmux
